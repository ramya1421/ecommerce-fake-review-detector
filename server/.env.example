# ─── DATABASE (Prisma / Express backend) ─────────────────────────────────────
# MySQL connection string — must match the same database as the Next.js frontend
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# ─── SERVER PORT ──────────────────────────────────────────────────────────────
# Render sets this automatically. Only set manually for local development.
# Default fallback in app.js is 3001.
PORT=3001

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL in production to restrict cross-origin requests.
# In development, leave unset — it defaults to * (all origins allowed).
# Example: https://your-app.vercel.app
FRONTEND_URL="https://your-app.vercel.app"

# ─── DATABASE (Prisma / Next.js frontend) ─────────────────────────────────────
# MySQL connection string — Railway, PlanetScale, or any MySQL 8 provider
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# ─── NEXTAUTH ─────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Must match your deployed Vercel URL exactly (no trailing slash)
# In development: http://localhost:3000
NEXTAUTH_URL="https://your-app.vercel.app"

# ─── EXPRESS BACKEND URL ──────────────────────────────────────────────────────
# Full URL of your deployed Express backend on Render (no trailing slash)
# In development: http://localhost:3001
NEXT_PUBLIC_API_URL="https://your-backend.onrender.com"
